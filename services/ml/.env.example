# ==============================================================================
# SentiMate ML Microservice Environment Configuration (.env.example)
# ==============================================================================

# Port and host bindings
HOST="127.0.0.1"
PORT=8000

# Shared secret bearer token authenticating communication from Next.js
ML_SERVICE_API_KEY="sentimate-ml-internal-secret-token"

# Optional paths to proprietary model weights (leave empty for honest rules-based fallback)
DISTILBERT_MODEL_PATH=""
XGBOOST_MODEL_PATH=""
