# SentiMate Web Application Environment Configuration
# Copy this file to .env.local and update with your actual service credentials.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public Supabase URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# AI Chatbot Integration (Google Gemini)
# -----------------------------------------------------------------------------
# Google Gemini API Key for server-side chat streaming
GEMINI_API_KEY=""

# Supported Gemini Model ID (e.g. gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL="gemini-1.5-flash"

# -----------------------------------------------------------------------------
# Machine Learning Microservice (FastAPI)
# -----------------------------------------------------------------------------
# Internal URL of the running Python FastAPI microservice
ML_SERVICE_URL="http://127.0.0.1:8000"

# Pre-shared Bearer API key between Next.js server and FastAPI
ML_SERVICE_API_KEY="sentimate-ml-internal-secret-token"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
