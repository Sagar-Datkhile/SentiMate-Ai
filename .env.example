# ==============================================================================
# SentiMate — Root Environment Template (.env.example)
# ==============================================================================
# Copy this template to .env.local:
#   cp .env.example .env.local
# Then fill in your local or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. AI Chatbot Integration (NVIDIA NIM / Nemotron)
# ------------------------------------------------------------------------------
CHAT_PROVIDER="nvidia"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# ------------------------------------------------------------------------------
# 3. Machine Learning Microservice (FastAPI)
# ------------------------------------------------------------------------------
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_API_KEY="sentimate-ml-internal-secret-token"
DISTILBERT_MODEL_PATH=""
XGBOOST_MODEL_PATH=""

# ------------------------------------------------------------------------------
# 4. Web Application Host & Runtime Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ------------------------------------------------------------------------------
# 5. Nodemailer & Outbound SMTP Mail Delivery (Server-side Only)
# ------------------------------------------------------------------------------
# Standard SMTP host (e.g. smtp.gmail.com, smtp.resend.com, or mailhog/mailpit for local dev)
SMTP_HOST=""
# Port: 587 (TLS/STARTTLS), 465 (SSL/TLS), or 1025 (local Mailpit/Mailhog)
SMTP_PORT="587"
# Set to "true" for port 465, or "false" for 587/STARTTLS
SMTP_SECURE="false"
# Authenticated SMTP user (e.g. support.sentimate@gmail.com)
SMTP_USER=""
# SMTP password (for Gmail, use a 16-character dedicated Google App Password)
SMTP_PASS=""
# Authorized From address (Never use user input as From)
SUPPORT_FROM_EMAIL="\"SentiMate Support\" <support.sentimate@gmail.com>"

